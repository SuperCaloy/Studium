# Copy this file to .env.local and fill in the keys you want to use.
# All keys are read only on the server (via the /api/generate route) and
# are NEVER sent to the browser. Add at least one to enable AI generation;
# the app falls back to the offline engine if none are set or all fail.
#
# You must set one key per provider you want in the fallback chain.
# Providers are tried in this order: Gemini, Groq, OpenRouter, Mistral.
# Get free keys from:
#   Gemini:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/settings/keys
#   Mistral:    https://console.mistral.ai/api-keys

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Optional: add up to 5 Gemini keys for automatic rotation. If a key is
# rate-limited or fails, the next key is tried before moving to the next provider.
# A key in a separate _2.._5 variable also works (Gemini only).
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional per-provider model overrides. Leave empty to use defaults.
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openrouter/free
# MISTRAL_MODEL=mistral-small-latest
